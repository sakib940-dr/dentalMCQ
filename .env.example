VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — error tracking. App works fine without this; errors just
# won't be reported anywhere. Get a free DSN at https://sentry.io
VITE_SENTRY_DSN=

# Push notifications — public VAPID key (safe to expose in frontend).
# The matching private key lives ONLY in the Supabase Edge Function
# secrets, never here. App works without this too — push setup is
# skipped silently if it's missing.
VITE_VAPID_PUBLIC_KEY=
